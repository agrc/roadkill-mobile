{
  "name": "roadkill-reporter-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website for the Utah Roadkill Reporter",
  "license": "MIT",
  "author": "Scott Davis <stdavis@utah.gov>",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production pnpm run build:css && remix build",
    "build:css": "tailwindcss -o ./app/tailwind.css",
    "dev:css": "tailwindcss -o ./app/tailwind.css --watch",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "serve": "cross-env NODE_ENV=production remix-serve ./build/index.js",
    "start": "cross-env NODE_ENV=development PORT=3002 concurrently \"pnpm run dev:css\" \"remix dev\""
  },
  "dependencies": {
    "@remix-run/node": "^2.17.4",
    "@remix-run/react": "^2.16.7",
    "@remix-run/serve": "^2.17.4",
    "cross-env": "^10.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.4",
    "@tailwindcss/cli": "^4.1.7",
    "@ugrc/eslint-config": "^1.2.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "tailwindcss": "^4.1.7"
  }
}
