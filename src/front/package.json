{
  "name": "roadkill-reporter",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "android": "expo run:android",
    "eas-build-pre-install": "bash ./scripts/eas-build-pre-install.sh",
    "format": "prettier --write .",
    "get-mile-markers": "node scripts/UpdateMileMarkerData.mjs",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "prestart": "sb-rn-get-stories",
    "start": "expo start --dev-client",
    "storybook-generate": "sb-rn-get-stories --config-path=./.storybook",
    "storybook-watch": "sb-rn-watcher",
    "test": "env-cmd -f .env.test jest --watch --coverage=false",
    "test:debug": "env-cmd -f .env.test jest -o --watch --coverage=false",
    "test:final": "npm run lint && env-cmd -f .env.test jest && npm run validate-translations",
    "update-constants": "env-cmd -f .env node scripts/updateConstants.mjs",
    "update-snapshots": "jest -u --coverage=false",
    "validate-translations": "node scripts/validateTranslations.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|react-clone-referenced-element|@react-native-community|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|native-base|@sentry/.*|autolinker|@ui-kitten/.*|p-timeout|i18n-js|cheap-ruler)"
    ]
  },
  "overrides": {
    "react-native-eva-icons": {
      "react": "$react"
    }
  },
  "dependencies": {
    "@eva-design/eva": "^2.2.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-firebase/analytics": "^22.2.0",
    "@react-native-firebase/app": "^22.2.0",
    "@react-navigation/drawer": "^7.3.12",
    "@react-navigation/elements": "^2.4.2",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/stack": "^7.3.2",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.76.2",
    "@turf/helpers": "^7.2.0",
    "@turf/length": "^7.2.0",
    "@ui-kitten/components": "^5.3.1",
    "@ui-kitten/eva-icons": "^5.3.1",
    "base-64": "^1.0.0",
    "cheap-ruler": "^4.0.0",
    "common": "file:../common",
    "date-fns": "^4.1.0",
    "expo": "~55.0.31",
    "expo-apple-authentication": "~55.0.17",
    "expo-application": "~55.0.19",
    "expo-asset": "~55.0.20",
    "expo-auth-session": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.40",
    "expo-device": "~55.0.21",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-image": "~55.0.11",
    "expo-image-loader": "~55.0.1",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-intent-launcher": "~55.0.16",
    "expo-linking": "~55.0.17",
    "expo-localization": "~55.0.19",
    "expo-location": "~55.1.14",
    "expo-mail-composer": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-task-manager": "~55.0.20",
    "expo-updates": "~55.0.33",
    "expo-web-browser": "~55.0.20",
    "formik": "^2.4.6",
    "i18n-js": "^4.5.1",
    "immer": "^10.1.1",
    "indefinite": "^2.5.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "mime": "^4.0.7",
    "p-timeout": "^6.1.4",
    "promise": "^8.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-autolink": "^4.2.0",
    "react-native-collapsible": "^1.6.1",
    "react-native-error-boundary": "^1.2.7",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-maps": "1.27.2",
    "react-native-pressable-opacity": "^1.0.10",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4",
    "react-phone-number-input": "^3.4.12",
    "use-immer": "^0.11.0",
    "yup": "^1.6.1",
    "yup-phone-lite": "^2.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@chromatic-com/storybook": "^3.2.6",
    "@emotion/react": "^11.14.0",
    "@esri/arcgis-rest-feature-service": "^4.1.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/slider": "5.1.2",
    "@sentry/cli": "^2.45.0",
    "@storybook/addon-ondevice-actions": "^8.6.4",
    "@storybook/addon-ondevice-controls": "^8.6.4",
    "@storybook/addon-webpack5-compiler-babel": "^3.0.6",
    "@storybook/react-native": "^8.6.4",
    "@storybook/theming": "^8.6.14",
    "babel-loader": "^10.0.0",
    "babel-preset-expo": "~55.0.8",
    "dotenv": "^16.5.0",
    "env-cmd": "^10.1.0",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "knex": "^3.1.0",
    "metro": "0.83.8",
    "pg": "^8.16.0",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-packagejson": "^2.5.14",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "typescript": "~5.9.2"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "protobufjs@7.4.0": true,
    "sqlite3@5.1.7": true,
    "@sentry/cli@2.45.0": true,
    "@sentry/cli@2.42.4": true
  }
}
